# Never commit corpora. The PhysioNet licences forbid redistribution outright,
# and the open sets are large enough that the downloader is the right way to get them.
data/raw/
data/interim/
data/processed/
!data/MANIFEST.json

# credentials
.env
*.token

# model artifacts
checkpoints/
outputs/
runs/
wandb/
*.safetensors
*.bin

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Kaggle dataset staging: derived copies of licensed corpora, uploaded via the API, never committed
kaggle/dataset/*.jsonl
kaggle/dataset/test/

# evaluation scratch (regenerable)
reports/eval_baseline/*_bertscore_cache.jsonl
reports/eval_baseline/*.log

# PatSnap raw API responses (scripts/search_papers.py cache)
research_paper/cache/

# Review 3 prompts dataset: derived copies of the test corpora, uploaded to Kaggle, never committed
kaggle/review3_data/*.jsonl
